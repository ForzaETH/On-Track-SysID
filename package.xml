<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Only lets colcon and rosdep find this plain python package; the library itself does not use ROS. -->
<package format="3">
  <name>on_track_sysid</name>
  <version>2.0.0</version>
  <description>Lateral tire identification (Pacejka) for scaled racecars: on-track and steady-state methods</description>
  <maintainer email="edoardo.ghignone@pbl.ee.ethz.ch">ForzaETH</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
